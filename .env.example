# ============================================================
# Patrimonio - variables de entorno de PostgreSQL (ejemplo)
# Copia este archivo a .env y ajusta los valores.
#   cp .env.example .env
# Nunca subas .env al repositorio.
# ============================================================

# Usuario administrador que crea la imagen de PostgreSQL
POSTGRES_USER=patrimonio

# Contrasena del usuario. Cambiala por una propia (sin comillas).
POSTGRES_PASSWORD=cambia_esta_contrasena

# Base de datos que se crea al inicializar el contenedor
POSTGRES_DB=patrimonio

# Interfaz del host donde se publica el puerto.
# 127.0.0.1 = solo local. Nunca uses 0.0.0.0 en este proyecto.
POSTGRES_BIND_ADDRESS=127.0.0.1

# Puerto del host. Si 5432 esta ocupado, usa por ejemplo 5433.
POSTGRES_PORT=5432

# Zona horaria del contenedor
TZ=UTC
